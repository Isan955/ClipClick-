<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ClipClick Modern Color Palette -->
    <!-- Primary Neon Accent: #B6FF00 (Stabilo Green) -->
    <Color x:Key="AccentColor">#B6FF00</Color>
    <Color x:Key="AccentColorHover">#CEFF33</Color>
    <Color x:Key="AccentColorPressed">#9EDD00</Color>
    <Color x:Key="AccentColorDim">#1A3300</Color>

    <!-- Dark Backgrounds -->
    <Color x:Key="BgRootColor">#0A0A0A</Color>
    <Color x:Key="BgSidebarColor">#0F0F0F</Color>
    <Color x:Key="BgCardColor">#141414</Color>
    <Color x:Key="BgCardHoverColor">#1A1A1A</Color>
    <Color x:Key="BgItemColor">#181818</Color>
    <Color x:Key="BgItemHoverColor">#222222</Color>
    <Color x:Key="BgItemActiveColor">#2A2A2A</Color>
    <Color x:Key="BgInputColor">#121212</Color>

    <!-- Borders & Dividers -->
    <Color x:Key="BorderLightColor">#262626</Color>
    <Color x:Key="BorderSubtleColor">#1A1A1A</Color>
    <Color x:Key="BorderAccentColor">#B6FF00</Color>

    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>
    <Color x:Key="TextMutedColor">#606060</Color>
    <Color x:Key="TextAccentColor">#B6FF00</Color>

    <!-- Status Colors -->
    <Color x:Key="DangerColor">#FF4D4D</Color>
    <Color x:Key="DangerHoverColor">#FF6666</Color>
    <Color x:Key="WarningColor">#FFAA00</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentColorPressed}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentColorDim}" />

    <SolidColorBrush x:Key="BgRootBrush" Color="{StaticResource BgRootColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BgItemBrush" Color="{StaticResource BgItemColor}" />
    <SolidColorBrush x:Key="BgItemHoverBrush" Color="{StaticResource BgItemHoverColor}" />
    <SolidColorBrush x:Key="BgItemActiveBrush" Color="{StaticResource BgItemActiveColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />

    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderAccentBrush" Color="{StaticResource BorderAccentColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextAccentBrush" Color="{StaticResource TextAccentColor}" />

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
</ResourceDictionary>
