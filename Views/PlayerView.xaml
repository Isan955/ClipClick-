<UserControl x:Class="ClipClick.Views.PlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid Margin="24,20,24,24">
        <Grid.RowDefinitions>
            <!-- Mode Switcher & Header -->
            <RowDefinition Height="Auto" />
            <!-- Hero Now Playing Card -->
            <RowDefinition Height="Auto" />
            <!-- Playlist / Details Section -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Mode Switcher Pill -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mode Selector -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                    CornerRadius="18" HorizontalAlignment="Left" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <!-- Local Player Button -->
                    <RadioButton Content="Local Player" GroupName="PlayerModeGroup"
                                 Style="{StaticResource NavTabButtonStyle}"
                                 Height="32" Margin="0" Padding="16,0"
                                 IsChecked="{Binding IsLocalMode, Mode=TwoWay}" />

                    <!-- External Media Button -->
                    <RadioButton Content="External Media (GSMTC)" GroupName="PlayerModeGroup"
                                 Style="{StaticResource NavTabButtonStyle}"
                                 Height="32" Margin="4,0,0,0" Padding="16,0"
                                 IsChecked="{Binding IsExternalMode, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <!-- Current Source Indicator -->
            <Border Grid.Column="1" Background="#1C1C1C" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TrackSource}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hero Now Playing Card -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                CornerRadius="16" Padding="24" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Track Info & Visual Art -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Neon Vinyl Icon Artwork -->
                    <Border Grid.Column="0" Width="68" Height="68" CornerRadius="14"
                            Background="#111111" BorderBrush="#222222" BorderThickness="1" Margin="0,0,18,0">
                        <Grid>
                            <Path Data="{StaticResource IconMusic}" Fill="{StaticResource AccentBrush}"
                                  Stretch="Uniform" Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Titles -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TrackTitle}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="20" FontWeight="Bold" FontFamily="{StaticResource MainFont}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding TrackArtist}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="14" FontFamily="{StaticResource MainFont}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Volume Section -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <!-- Mute / Unmute Button -->
                        <Button Command="{Binding ToggleMuteCommand}" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,6,0">
                            <Path Stretch="Uniform" Width="16" Height="16">
                                <Path.Style>
                                    <Style TargetType="{x:Type Path}">
                                        <Setter Property="Data" Value="{StaticResource IconVolumeHigh}" />
                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource IconVolumeMute}" />
                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <!-- Volume Slider -->
                        <Slider Width="90" Minimum="0" Maximum="100" Value="{Binding Volume}"
                                Style="{StaticResource ModernSliderStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Seeker Bar & Timestamps -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Slider Grid.Row="0" Minimum="0" Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds}"
                            Style="{StaticResource ModernSliderStyle}"
                            Margin="0,0,0,6"
                            IsEnabled="{Binding IsLocalMode}" />

                    <TextBlock Grid.Row="1" Text="{Binding TimeString}" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5" HorizontalAlignment="Right" />
                </Grid>

                <!-- Media Transport Control Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Previous Track -->
                    <Button Command="{Binding PreviousCommand}" Style="{StaticResource RoundMediaButton}" Margin="0,0,12,0" ToolTip="Previous Track">
                        <Path Data="{StaticResource IconPrevious}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" Width="14" Height="14" />
                    </Button>

                    <!-- Play / Pause -->
                    <Button Command="{Binding TogglePlayPauseCommand}" Style="{StaticResource RoundPlayButton}" Margin="0,0,12,0" ToolTip="Play / Pause">
                        <Path Stretch="Uniform" Width="18" Height="18">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}">
                                    <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                    <Setter Property="Fill" Value="#0A0A0A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconPause}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>

                    <!-- Next Track -->
                    <Button Command="{Binding NextCommand}" Style="{StaticResource RoundMediaButton}" Margin="0,0,12,0" ToolTip="Next Track">
                        <Path Data="{StaticResource IconNext}" Fill="{StaticResource TextPrimaryBrush}" Stretch="Uniform" Width="14" Height="14" />
                    </Button>

                    <!-- Stop -->
                    <Button Command="{Binding StopCommand}" Style="{StaticResource RoundMediaButton}" ToolTip="Stop Playback">
                        <Path Data="{StaticResource IconStop}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="12" Height="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lower Section: Local Playlist OR External Media Hub -->
        <Grid Grid.Row="2">
            <!-- LOCAL PLAYLIST VIEW (Shown when IsLocalMode is True) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocalMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Header & Add File/Folder Buttons -->
                <Grid Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconPlaylist}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Music Playlist" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="{Binding Playlist.Count, StringFormat='{} ({0} songs)'}" Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Playlist Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Add Files -->
                        <Button Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAddFile}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                <TextBlock Text="Add Files" />
                            </StackPanel>
                        </Button>

                        <!-- Add Folder -->
                        <Button Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconAddFolder}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                <TextBlock Text="Add Folder" />
                            </StackPanel>
                        </Button>

                        <!-- Clear Playlist -->
                        <Button Command="{Binding ClearPlaylistCommand}" Style="{StaticResource IconButton}" ToolTip="Clear Playlist">
                            <Path Data="{StaticResource IconTrash}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Playlist Container -->
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="8">
                    <Grid>
                        <!-- Empty Playlist State -->
                        <Border CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaylistEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                <Path Data="{StaticResource IconMusic}" Fill="#2A2A2A" Stretch="Uniform" Width="48" Height="48" Margin="0,0,0,12" />
                                <TextBlock Text="No Songs in Playlist" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Add MP3, WAV, FLAC, or M4A audio files to begin listening." Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                <Button Command="{Binding AddFilesCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Height="32">
                                    <TextBlock Text="Choose Audio Files" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Playlist Card Items -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.Style>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaylistEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding Playlist}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Background="#161616" CornerRadius="8" Padding="12,10" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick"
                                                              Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}" />
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Playing Indicator Dot / Music Note -->
                                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="#222222" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Path Stretch="Uniform" Width="10" Height="10">
                                                        <Path.Style>
                                                            <Style TargetType="{x:Type Path}">
                                                                <Setter Property="Data" Value="{StaticResource IconMusic}" />
                                                                <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                                                        <Setter Property="Fill" Value="#0A0A0A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>

                                                <!-- Track Title & Artist -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Artist}" Foreground="{StaticResource TextMutedBrush}"
                                                               FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedDuration}" Foreground="{StaticResource TextMutedBrush}"
                                                           FontSize="12" VerticalAlignment="Center" Margin="16,0" />

                                                <!-- Remove Track Button -->
                                                <Button Grid.Column="3"
                                                        Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButton}" Width="28" Height="28">
                                                    <Path Data="{StaticResource IconClose}" Fill="{StaticResource TextSecondaryBrush}" Stretch="Uniform" Width="9" Height="9" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- EXTERNAL MEDIA HUB VIEW (Shown when IsExternalMode is True) -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExternalMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="24">
                    <StackPanel VerticalAlignment="Center" MaxWidth="600" HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="#1A2800" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource IconExternalMedia}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Windows System Media Transport (GSMTC)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Live synchronization with media playing in Spotify, Google Chrome, Microsoft Edge, and native Windows players." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <Border Background="#161616" CornerRadius="8" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Current Source App:" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" />
                                    <TextBlock Text="{Binding TrackSource}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Track Title:" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" />
                                    <TextBlock Text="{Binding TrackTitle}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Artist / Channel:" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" />
                                    <TextBlock Text="{Binding TrackArtist}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
