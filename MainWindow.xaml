<Window x:Class="ClipClick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ClipClick.Views"
        mc:Ignorable="d"
        Title="ClipClick"
        Height="700" Width="1060"
        MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BgRootBrush}">

    <!-- Outer Window Border -->
    <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Custom TitleBar -->
                <RowDefinition Height="36" />
                <!-- Main App Layout (Sidebar + Content) -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- CUSTOM MODERN TITLE BAR -->
            <Border Grid.Row="0" Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- App Branding -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Draggable Filler -->
                        <ColumnDefinition Width="*" />
                        <!-- Window Chrome Controls -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Branding -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- Neon Logo Icon -->
                        <Path Data="{StaticResource IconLogo}" Fill="{StaticResource AccentBrush}"
                              Stretch="Uniform" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="ClipClick" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="{StaticResource MainFont}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentDimBrush}" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRO" Foreground="{StaticResource AccentBrush}" FontSize="9.5" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button -->
                        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                            <Path Data="{StaticResource IconMinimize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="10" Height="10" />
                        </Button>

                        <!-- Maximize / Restore Button -->
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
                            <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="10" Height="10" />
                        </Button>

                        <!-- Close Button -->
                        <Button Style="{StaticResource TitleBarCloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="10" Height="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MAIN APPLICATION CONTENT LAYOUT -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Left Navigation Sidebar -->
                    <ColumnDefinition Width="220" />
                    <!-- Content Pages Area -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0" Padding="14,18,14,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Navigation Links -->
                            <RowDefinition Height="*" />
                            <!-- Dynamic Island Quick Toggle Pill & Status -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nav Tabs List -->
                        <StackPanel Grid.Row="0">
                            <!-- Section Title -->
                            <TextBlock Text="MENU" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" FontWeight="Bold" Margin="10,0,0,10" />

                            <!-- Tab 1: Clipboard Manager -->
                            <RadioButton GroupName="NavTabs" Style="{StaticResource NavTabButtonStyle}"
                                         IsChecked="{Binding IsClipboardTabSelected, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconClipboard}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Clipboard" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Tab 2: Music & Media Hub -->
                            <RadioButton GroupName="NavTabs" Style="{StaticResource NavTabButtonStyle}"
                                         IsChecked="{Binding IsMediaTabSelected, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconMusic}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Music &amp; Media" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Tab 3: Settings & Preferences -->
                            <RadioButton GroupName="NavTabs" Style="{StaticResource NavTabButtonStyle}"
                                         IsChecked="{Binding IsSettingsTabSelected, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          Stretch="Uniform" Width="16" Height="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Island Quick Toggle Widget Card -->
                        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconIsland}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,6,0" />
                                        <TextBlock Text="Dynamic Island" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding ToggleIslandCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" Height="30" FontSize="11.5"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="Toggle Island" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT MAIN CONTENT PAGES -->
                <Grid Grid.Column="1" Background="{StaticResource BgRootBrush}">
                    <!-- Clipboard View (Page 0) -->
                    <views:ClipboardView DataContext="{Binding ClipboardVM}">
                        <views:ClipboardView.Style>
                            <Style TargetType="{x:Type UserControl}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedNavIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:ClipboardView.Style>
                    </views:ClipboardView>

                    <!-- Music & Media Hub View (Page 1) -->
                    <views:PlayerView DataContext="{Binding PlayerVM}">
                        <views:PlayerView.Style>
                            <Style TargetType="{x:Type UserControl}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedNavIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="1">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:PlayerView.Style>
                    </views:PlayerView>

                    <!-- Settings View (Page 2) -->
                    <views:SettingsView DataContext="{Binding SettingsVM}">
                        <views:SettingsView.Style>
                            <Style TargetType="{x:Type UserControl}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedNavIndex, RelativeSource={RelativeSource AncestorType=Window}}" Value="2">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:SettingsView.Style>
                    </views:SettingsView>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
