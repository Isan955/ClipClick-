<UserControl x:Class="ClipClick.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,20,24,24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <!-- Header -->
            <TextBlock Text="Settings &amp; Preferences" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="20" FontWeight="Bold" Margin="0,0,0,18" />

            <!-- Group 1: General & Behavior -->
            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Application Behavior" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Start with Windows" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5" FontWeight="Medium" />
                            <TextBlock Text="Automatically launch ClipClick in the background on startup"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}"
                                  Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,16" />

                    <!-- Minimize to Tray on Close -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Minimize to System Tray" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5" FontWeight="Medium" />
                            <TextBlock Text="Keep ClipClick running quietly in the tray when closing the window"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding MinimizeToTrayOnClose}"
                                  Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 2: Dynamic Island -->
            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Dynamic Island Widget" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <!-- Show Dynamic Island -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Enable Floating Dynamic Island" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5" FontWeight="Medium" />
                            <TextBlock Text="Display the compact floating pill widget on your desktop"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowDynamicIsland}"
                                  Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,16" />

                    <!-- Dynamic Island Always on Top -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Always on Top" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5" FontWeight="Medium" />
                            <TextBlock Text="Keep the Dynamic Island floating above other application windows"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding DynamicIslandTopmost}"
                                  Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,16" />

                    <!-- Auto-Expand on Hover -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-Expand on Hover" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5" FontWeight="Medium" />
                            <TextBlock Text="Expand the Island automatically when hovering cursor over it"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding DynamicIslandAutoExpand}"
                                  Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Group 3: Data Management -->
            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Data &amp; Storage" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />

                    <!-- Batas Riwayat Clipboard -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Batas Riwayat Clipboard" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5" FontWeight="Medium" />
                            <TextBlock Text="Jumlah maksimal riwayat teks yang disimpan di database SQLite"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Limit Selector RadioButtons -->
                        <Border Grid.Column="1" Background="#181818" CornerRadius="8" Padding="3" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="100" GroupName="ClipLimitGroup"
                                             Style="{StaticResource NavTabButtonStyle}"
                                             Height="28" Padding="12,0" Margin="0"
                                             IsChecked="{Binding IsLimit100, Mode=TwoWay}" />
                                <RadioButton Content="250" GroupName="ClipLimitGroup"
                                             Style="{StaticResource NavTabButtonStyle}"
                                             Height="28" Padding="12,0" Margin="2,0"
                                             IsChecked="{Binding IsLimit250, Mode=TwoWay}" />
                                <RadioButton Content="500" GroupName="ClipLimitGroup"
                                             Style="{StaticResource NavTabButtonStyle}"
                                             Height="28" Padding="12,0" Margin="0"
                                             IsChecked="{Binding IsLimit500, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,0,0,16" />

                    <!-- Clear History Action -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Hapus Riwayat Clipboard" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13.5" FontWeight="Medium" />
                            <TextBlock Text="Hapus semua teks yang tidak disematkan (unpinned). Teks yang disematkan tetap tersimpan."
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding ClearAllClipboardCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="14,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconTrash}" Fill="{StaticResource DangerBrush}" Stretch="Uniform" Width="12" Height="12" Margin="0,0,6,0" />
                                <TextBlock Text="Hapus Riwayat" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Feedback message when history cleared -->
                    <Border CornerRadius="8" Background="#162E00" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="12,8" Margin="0,14,0,0">
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasClearStatus}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheck}" Fill="{StaticResource AccentBrush}" Stretch="Uniform" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ClearStatusMessage}" Foreground="{StaticResource AccentBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Group 4: About & Technical Info -->
            <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderLightBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="About ClipClick" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Version" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                        <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Target Framework" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                        <TextBlock Text="{Binding TargetPlatform}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Audio Engine" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                        <TextBlock Text="{Binding AudioEngineInfo}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Database" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                        <TextBlock Text="{Binding DatabaseEngineInfo}" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="External Media" Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                        <TextBlock Text="Windows 10 GSMTC (Global Transport Controls)" Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
